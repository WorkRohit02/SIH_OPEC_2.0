PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_REFRESH_EXPIRES_IN=30d

# ImageKit Credentials
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Digital Signature Prototype Keys (Base64 encoded PEM or file paths)
# Leave blank to auto-generate prototype ephemeral RSA key pair on startup if missing
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=
